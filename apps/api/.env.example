# Application
PORT=3002

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexvideo"

# Cache / Queue
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# External APIs
YOUTUBE_API_KEY="your-youtube-api-key-here"
GOOGLE_TRENDS_REGION="BR"
OPENAI_API_KEY="your-openai-api-key-here"

# Stripe
# ⚠️  Each environment MUST use its own webhook endpoint and secret:
#   - dev/local: obtain via `stripe listen --forward-to localhost:3002/billing/webhook`
#   - staging:   Stripe Dashboard → Developers → Webhooks → nexvideo-staging endpoint → Signing secret
#   - production: Stripe Dashboard → Developers → Webhooks → nexvideo-prod endpoint → Signing secret
# Keys must match the environment:
#   - dev/staging → sk_test_...  +  whsec_... (from stripe listen or test endpoint)
#   - production  → sk_live_...  +  whsec_... (from live endpoint)
# See docs/stripe-webhook-rotation.md for key rotation runbook.
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key-here"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret-here"
STRIPE_SUCCESS_URL="http://localhost:3001/billing/success"
STRIPE_CANCEL_URL="http://localhost:3001/billing/cancel"
STRIPE_PORTAL_RETURN_URL="http://localhost:3001/billing"

# Email (Resend)
RESEND_API_KEY="re_your-resend-api-key-here"

# Application URLs
APP_URL="http://localhost:3001"

# Observability (optional — leave empty to disable Sentry locally)
SENTRY_DSN=""
